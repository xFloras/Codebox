# Copy this file to .env and fill in your own values:
#   cp example.env .env

# PostgreSQL
POSTGRES_DB=codebox_db
POSTGRES_USER=codebox_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Application
APP_PORT=8080

# JWT (Base64-encoded 256-bit key, generate with: openssl rand -base64 32)
SECURITY_JWT_SECRET_KEY=change_me
SECURITY_JWT_EXPIRATION=3600000
